# Copia este archivo como .env.local para probar en tu computador.
# En Vercel, define estas variables en Project Settings → Environment Variables.

# Obligatoria. Llave de la API de Anthropic (solo servidor, nunca llega al navegador).
ANTHROPIC_API_KEY=

# Opcional. Sitios que pueden insertar el chatbot en un iframe, separados por espacios.
# Si no se define, se permiten plasticfisherman.com y acleanerplanet.org.
# FRAME_ANCESTORS=https://www.misitio.com https://misitio.com
